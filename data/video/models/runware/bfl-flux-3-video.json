  "input": {
    "model": {
      "type": "string",
      "const": "bfl:flux@3-video",
      "description": "Identifier of the model to use for generation."
    },
    "taskType": {
      "type": "string",
      "const": "videoInference",
      "description": "Identifier for the type of task being performed"
    },
    "taskUUID": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 identifier for tracking tasks and matching async responses. Must be unique per task."
    },
    "positivePrompt": {
      "type": "string",
      "description": "Text prompt describing elements to include in the generated output."
    },
    "width": {
      "type": "integer",
      "description": "Width of the generated media in pixels."
    },
    "height": {
      "type": "integer",
      "description": "Height of the generated media in pixels."
    },
    "resolution": {
      "type": "string",
      "enum": [
        "720p",
        "1080p"
      ],
      "default": "720p",
      "description": "Resolution preset for the output. When used with input media, automatically matches the aspect ratio from the input."
    },
    "duration": {
      "type": [
        "integer",
        "string"
      ],
      "default": "auto",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 5,
          "maximum": 20
        },
        {
          "const": "auto"
        }
      ],
      "description": "Length of the generated video in seconds. The total number of frames produced is determined by duration multiplied by the model's frame rate (fps)."
    },
    "numberResults": {
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 4,
      "description": "Number of results to generate. Each result uses a different seed, producing variations of the same parameters."
    },
    "settings": {
      "type": "object",
      "description": "Global inference settings.",
      "properties": {
        "audio": {
          "type": "boolean",
          "default": true,
          "description": "Generate synchronized audio."
        },
        "draft": {
          "type": "boolean",
          "description": "Enable draft mode for rapid iteration. Generates a fast preview. Use the returned draft cache with `inputs.draftCache` to produce full quality output from an approved draft."
        },
        "safetyTolerance": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 4,
          "description": "Tolerance level for content moderation. Lower values are stricter; higher values are more permissive."
        }
      }
    },
    "inputs": {
      "type": "object",
      "description": "The unified payload wrapper for complex media assets dictating image, video or audio inference constraints.",
      "properties": {
        "frameImages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "description": "An array of frame-specific image inputs to guide video generation. Each item can be either a plain image input (UUID, URL, Data URI, or Base64) or an object that pairs an image with a target position in the video. Must include at least one image that is not the last frame.",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "description": "Image input (UUID, URL, Data URI, or Base64)."
              },
              {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "description": "Image input (UUID, URL, Data URI, or Base64)."
                  },
                  "frame": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "Named position in the video."
                      },
                      {
                        "type": "integer",
                        "minimum": -1,
                        "description": "Zero-based frame index. Use -1 for the last frame."
                      }
                    ],
                    "description": "Target frame position for the image. Accepts a named position like `first` or `last`, or a zero-based frame index (-1 for the last frame)."
                  },
                  "timestamp": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20,
                    "multipleOf": 0.01,
                    "description": "Timestamp in seconds indicating where the reference image is applied in the video. Hundredths-of-a-second precision."
                  }
                },
                "required": [
                  "image"
                ]
              }
            ],
            "description": "Use either frame or timestamp, not both."
          }
        },
        "video": {
          "type": "string",
          "description": "Video input (UUID or URL). Source video for extension."
        },
        "draftCache": {
          "type": "string",
          "description": "Draft cache bundle from a previous draft mode generation (URL or Base64). Provide this to produce full quality output from an approved draft preview."
        }
      }
    },
    "safety": {
      "type": "object",
      "description": "Content safety checking configuration for video generation.",
      "properties": {
        "checkContent": {
          "type": "boolean",
          "description": "Enable or disable content safety checking. Increases total generation time."
        },
        "mode": {
          "type": "string",
          "default": "fast",
          "oneOf": [
            {
              "const": "fast",
              "description": "Checks key frames."
            },
            {
              "const": "full",
              "description": "Checks all frames."
            }
          ],
          "description": "Safety checking mode for video generation."
        }
      }
    },
    "webhookURL": {
      "type": "string",
      "format": "uri",
      "description": "Specifies a webhook URL where JSON responses will be sent via HTTP POST when generation tasks complete. For batch requests with multiple results, each completed item triggers a separate webhook call as it becomes available."
    },
    "includeCost": {
      "type": "boolean",
      "description": "Include task cost in the response."
    },
    "uploadEndpoint": {
      "type": "string",
      "format": "uri",
      "description": "Specifies a URL where the generated content will be automatically uploaded using the HTTP PUT method. The raw binary data of the media file is sent directly as the request body. For secure uploads to cloud storage, use presigned URLs that include temporary authentication credentials."
    },
    "ttl": {
      "type": "integer",
      "minimum": 60,
      "description": "Time-to-live (TTL) in seconds for generated content. Only applies when `outputType` is `URL`."
    },
    "outputType": {
      "type": "string",
      "enum": [
        "URL"
      ],
      "default": "URL",
      "description": "Video output type."
    },
    "outputFormat": {
      "type": "string",
      "enum": [
        "MP4",
        "WEBM",
        "MOV"
      ],
      "default": "MP4",
      "description": "Specifies the file format of the generated output. The available values depend on the task type and the specific model's capabilities."
    },
    "outputQuality": {
      "type": "integer",
      "default": 95,
      "minimum": 20,
      "maximum": 99,
      "description": "Compression quality of the output. Higher values preserve quality but increase file size."
    },
    "deliveryMethod": {
      "type": "string",
      "default": "async",
      "oneOf": [
        {
          "const": "async",
          "description": "Returns an immediate acknowledgment with the task UUID. Poll for results using getResponse. Required for long-running tasks like video generation."
        }
      ],
      "description": "Determines how the API delivers task results."
    }
  }
}
