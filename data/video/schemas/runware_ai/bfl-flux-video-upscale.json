{
    "openapi": "3.1.0",
    "info": {
        "title": "Runware API - FLUX Video Upscale",
        "summary": "FLUX-powered video upscaling with precise and creative enhancement modes",
        "description": "FLUX Video Upscale is a dedicated video enhancement model from Black Forest Labs for increasing source footage to 1080p, 2K, or 4K while preserving motion and the original audio track. It supports a source-faithful precise mode for faces, products, and brand-sensitive footage, plus a more creative enhancement mode that restores and invents finer detail for generated clips, scenery, textures, and crowd shots. The endpoint accepts clips up to 20 seconds long and can optionally use a prompt to steer the type of detail it enhances.",
        "version": "1.0.0",
        "x-model-id": "bfl-flux-video-upscale",
        "x-air-id": "bfl:flux@video-upscale",
        "x-status": "live",
        "x-creator": {
            "id": "black-forest-labs",
            "name": "Black Forest Labs",
            "logo": "https://assets.runware.ai/07bfd96d-d2df-4d52-aba5-636fb27874be.png"
        },
        "x-capabilities": [
            "video-to-video",
            "upscale",
            "checkpoint"
        ],
        "x-modes": [
            {
                "id": "video",
                "inputs": [
                    "video"
                ]
            }
        ],
        "x-released-at": "2026-08-20T00:00:00Z",
        "x-cover-image": "https://assets.runware.ai/covers/bfl-flux-video-upscale.jpg",
        "x-pricing": {
            "overview": "Precise: $0.075/Megapixel-second\nCreative: $0.105/Megapixel-second",
            "examples": [
                {
                    "configuration": "upscale",
                    "price": "$2.23",
                    "latencyMs": 192690,
                    "exampleId": "marquetry-workshop-archive-restoration"
                },
                {
                    "configuration": "upscale",
                    "price": "$2.23",
