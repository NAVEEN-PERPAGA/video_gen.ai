                },
                {
                    "configuration": "upscale",
                    "price": "$2.23",
                    "latencyMs": 187539,
                    "exampleId": "mycelium-leather-lab-b-roll"
                },
                {
                    "configuration": "upscale",
                    "price": "$2.23",
                    "latencyMs": 113288,
                    "exampleId": "subsea-cable-docuseries-titles"
                }
            ]
        }
    },
