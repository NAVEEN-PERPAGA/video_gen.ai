                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "model": {
                            "title": "Model",
                            "description": "Identifier of the model to use for generation.",
                            "type": "string",
                            "const": "bytedance:50@1"
                        },
                        "taskType": {
                            "title": "Task Type",
