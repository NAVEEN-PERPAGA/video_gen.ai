    "info": {
        "title": "Runware API - MiniMax H3 Max",
        "summary": "High-throughput video generation with stronger prompt adherence, native synced audio, and first-to-last frame control",
        "description": "MiniMax H3 Max is a performance-tuned variant of MiniMax H3 built for faster video generation while preserving strong prompt following and polished audiovisual results. It supports text-to-video and image-to-video workflows, including optional first-and-last-frame guidance for more controlled motion between key images, and is well suited to rapid ideation, high-volume content production, and interactive creative workflows that need lower latency without giving up visual quality.",
        "version": "1.0.0",
        "x-model-id": "minimax-h3-max",
        "x-air-id": "minimax:h3@max",
        "x-status": "live",
        "x-creator": {
            "id": "minimax",
            "name": "MiniMax",
            "logo": "https://assets.runware.ai/b76b19c9-dd5c-4128-9439-7c9ec5088ecc.png"
        },
        "x-capabilities": [
            "text-to-video",
            "image-to-video",
            "checkpoint"
        ],
        "x-released-at": "2026-08-26T00:00:00Z",
        "x-cover-image": "https://assets.runware.ai/covers/minimax-h3-max.jpg",
        "x-pricing": {
            "examples": [
                {
                    "configuration": "first-frame · 768p · 5s",
                    "price": "$0.40",
                    "latencyMs": 23476,
                    "exampleId": "vineyard-falconry-social-video-ad"
                },
                {
                    "configuration": "first-last-frame · 480p · 15s",
                    "price": "$0.75",
                    "latencyMs": 25360,
                    "exampleId": "accordion-restoration-reel-ad"
                },
                {
